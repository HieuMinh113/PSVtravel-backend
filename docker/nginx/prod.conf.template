# Cấu hình nginx cho máy chủ thật. Hai tên miền:
#   ${PSV_DOMAIN}      -> Next.js (giao diện khách hàng)
#   ${PSV_API_DOMAIN}  -> Laravel (API + trang quản trị + ảnh upload)
#
# File này là bản mẫu: nginx tự thay ${PSV_DOMAIN} và ${PSV_API_DOMAIN} bằng
# giá trị trong .env lúc container khởi động.

# ---- Giới hạn tần suất, chặn dò mật khẩu và spam form ----
limit_req_zone $binary_remote_addr zone=psv_chung:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=psv_dangnhap:10m rate=1r/s;

# ---- Chuyển hết HTTP sang HTTPS, trừ đường xác thực chứng chỉ ----
server {
    listen 80;
    server_name ${PSV_DOMAIN} www.${PSV_DOMAIN} ${PSV_API_DOMAIN};

    # Let's Encrypt đặt tệp kiểm chứng vào đây khi cấp và gia hạn chứng chỉ
    location /.well-known/acme-challenge/ {
        root /var/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ==========================================================================
#  GIAO DIỆN KHÁCH HÀNG — Next.js
# ==========================================================================
server {
    listen 443 ssl;
    http2 on;
    server_name ${PSV_DOMAIN} www.${PSV_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${PSV_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PSV_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Trình duyệt nhớ chỉ vào bằng HTTPS trong 1 năm
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    client_max_body_size 20M;
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;
    gzip_min_length 1024;

    limit_req zone=psv_chung burst=60 nodelay;

    # Tệp tĩnh Next sinh ra có mã băm trong tên nên giữ vĩnh viễn được
    location /_next/static/ {
        proxy_pass http://frontend:3000;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    location / {
        proxy_pass http://frontend:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}

# ==========================================================================
#  API + TRANG QUẢN TRỊ — Laravel
# ==========================================================================
server {
    listen 443 ssl;
    http2 on;
    server_name ${PSV_API_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${PSV_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PSV_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    root /var/www/public;
    index index.php;
    client_max_body_size 20M;

    gzip on;
    gzip_types application/json application/javascript text/css;
    gzip_min_length 1024;

    limit_req zone=psv_chung burst=60 nodelay;

    # Ảnh admin tải lên. Trỏ thẳng thư mục thật thay vì qua liên kết tượng
    # trưng public/storage — không phụ thuộc `artisan storage:link`.
    location /storage/ {
        alias /var/www/storage/app/public/;
        access_log off;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";

        # Không bao giờ chạy mã trong thư mục người dùng tải lên
        location ~ \.(php|phtml|phar|sh|py|cgi)$ {
            deny all;
        }
        try_files $uri =404;
    }

    # Trang đăng nhập quản trị — siết chặt để chặn dò mật khẩu tự động
    location = /admin/login {
        limit_req zone=psv_dangnhap burst=5 nodelay;
        try_files $uri /index.php?$query_string;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass app:9000;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        # Laravel đứng sau nginx nên phải tự báo là đang chạy HTTPS,
        # thiếu dòng này thì mọi đường dẫn sinh ra sẽ là http://
        fastcgi_param HTTPS on;
        fastcgi_read_timeout 300;
        fastcgi_buffers 16 32k;
        fastcgi_buffer_size 64k;
    }

    # Chặn truy cập .env, .git và mọi tệp ẩn
    location ~ /\.(?!well-known).* {
        deny all;
    }
}
