# Cấu hình nginx cho máy chủ thật. Hai tên miền:
#   ${PSV_DOMAIN}      -> Next.js (giao diện khách hàng)
#   ${PSV_API_DOMAIN}  -> Laravel (API + trang quản trị + ảnh upload)
#
# File này là bản mẫu: nginx tự thay ${PSV_DOMAIN} và ${PSV_API_DOMAIN} bằng
# giá trị trong .env lúc container khởi động.

# ---- Giới hạn tần suất, chặn dò mật khẩu và spam form ----
# Tính theo IP. Cả văn phòng dùng chung MỘT IP (wifi công ty), khách 4G cũng hay
# chung IP của nhà mạng. Trước đây mọi lượt — kể cả ảnh, JS, CSS, font — đều
# tính vào 30 lượt/giây, dồn 60 rồi chặn ngay: mở một trang admin đã tốn 31
# lượt, nên 3 người mở cùng lúc bị chặn 1/3 (trang thiếu chữ, đứng hình — "sáng
# web hơi lag" lúc cả công ty vào chấm công). Giờ:
#  - tệp tĩnh (ảnh, JS, CSS, font, bộ nhận diện khuôn mặt) KHÔNG tính
#  - trang + PHP: 30 lượt/giây, dồn được 150 — 60 lượt đầu đi ngay, phần sau
#    xếp hàng chờ (chậm một chút, không lỗi); quá 150 mới chặn (503)
#  - máy chủ Next.js gọi API lúc dựng trang KHÔNG tính: mọi lời gọi đó đi ra từ
#    một IP, bot quét 56 trang đã làm 36% bị chặn → trang tour không cập nhật.
#    Next gửi kèm header X-Psv-Noi-Bo = khoá PSV_NOI_BO trong .env (scripts/
#    trien-khai.sh tự sinh). Khoá sai / không có header → tính như mọi người.
#    Ba map dưới: kể cả khi khoá rỗng, lượt KHÔNG có header vẫn bị tính.
# Khoá 48 ký tự dài hơn ô băm mặc định (64 byte) của map → nginx không khởi động
map_hash_bucket_size 128;
map $http_x_psv_noi_bo $psv_noi_bo_dung { default 0; "${PSV_NOI_BO}" 1; }
map $http_x_psv_noi_bo $psv_co_noi_bo { default 1; "" 0; }
map "$psv_co_noi_bo$psv_noi_bo_dung" $psv_khoa_gioi_han { default $binary_remote_addr; "11" ""; }

limit_req_zone $psv_khoa_gioi_han zone=psv_chung:10m rate=30r/s;
# Ảnh Next tự nén (/_next/image): trang chủ ~20 ảnh/lượt, nén lần đầu tốn CPU
limit_req_zone $binary_remote_addr zone=psv_anh:10m rate=50r/s;
limit_req_zone $binary_remote_addr zone=psv_dangnhap:10m rate=1r/s;

# ---- Nhật ký: y như dạng "main" mặc định của nginx + tên miền ở cuối dòng ----
# Để tách lượt vào website và lượt vào API (scripts/dem-bot-ai.sh) — trước đây
# không phân biệt được api.psvtravel.com/sitemap.xml (404) với sitemap thật.
# rt = tổng thời gian nginx phục vụ, urt = thời gian Next / PHP xử lý (giây) —
# scripts/kiem-tra-tai.sh đọc để biết giờ nào, trang nào chậm.
log_format psv_co_ten_mien '$remote_addr - $remote_user [$time_local] "$request" '
                           '$status $body_bytes_sent "$http_referer" '
                           '"$http_user_agent" "$http_x_forwarded_for" "$host" '
                           'rt=$request_time urt=$upstream_response_time';

# ---- Chuyển hết HTTP sang HTTPS, trừ đường xác thực chứng chỉ ----
server {
    listen 80;
    server_name ${PSV_DOMAIN} ${PSV_API_DOMAIN};

    # Let's Encrypt đặt tệp kiểm chứng vào đây khi cấp và gia hạn chứng chỉ
    location /.well-known/acme-challenge/ {
        root /var/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# http://www → thẳng https://tên-miền-chuẩn trong MỘT lần chuyển.
# Trước đây đi hai chặng (http://www → https://www → https://không-www); mỗi
# chặng là một lượt khứ hồi mạng — PageSpeed mobile tính ~0,6s "multiple page
# redirects". Vẫn giữ đường xác thực chứng chỉ vì chứng chỉ có cả tên www.
server {
    listen 80;
    server_name www.${PSV_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/certbot;
    }

    location / {
        return 301 https://${PSV_DOMAIN}$request_uri;
    }
}

# ==========================================================================
#  GIAO DIỆN KHÁCH HÀNG — Next.js
# ==========================================================================
server {
    listen 443 ssl;
    http2 on;
    server_name ${PSV_DOMAIN} www.${PSV_DOMAIN};
    access_log /var/log/nginx/access.log psv_co_ten_mien;

    # Gộp về một tên miền chuẩn: www chuyển hẳn (301) sang không-www. Trước đây
    # www trả 200 (bản kiểm tra kỹ thuật bắt được), thẻ canonical có bù nhưng
    # 301 dứt khoát hơn, tránh Google coi hai địa chỉ là hai trang.
    if ($host = www.${PSV_DOMAIN}) {
        return 301 https://${PSV_DOMAIN}$request_uri;
    }

    ssl_certificate     /etc/letsencrypt/live/${PSV_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PSV_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Trình duyệt nhớ chỉ vào bằng HTTPS trong 1 năm
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # Chặn sẵn các API trình duyệt web không dùng (vị trí, mic, thanh toán).
    # Camera chỉ cho chính website: nút "Quét mã" ở trang Voucher & ưu đãi
    # (/khuyen-mai) đọc QR trên voucher — camera=() thì nút này báo lỗi.
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=(self), payment=(), usb=()" always;

    client_max_body_size 20M;
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;
    gzip_min_length 1024;

    # Tệp tĩnh Next sinh ra có mã băm trong tên nên giữ vĩnh viễn được.
    # Không giới hạn tần suất (xem đầu file).
    location ^~ /_next/static/ {
        proxy_pass http://frontend:3000;
        add_header Cache-Control "public, max-age=31536000, immutable";
        # LƯU Ý nginx: khối nào tự khai add_header thì KHÔNG kế thừa add_header
        # của server — phải ghi lại header bảo mật, không thì tệp tĩnh mất HSTS.
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        access_log off;
    }

    # Ảnh Next tự nén: vùng giới hạn riêng, rộng hơn trang (một trang ~20 ảnh)
    location ^~ /_next/image {
        limit_req zone=psv_anh burst=300 delay=100;
        proxy_pass http://frontend:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        access_log off;
    }

    location / {
        limit_req zone=psv_chung burst=150 delay=60;
        proxy_pass http://frontend:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}

# ==========================================================================
#  API + TRANG QUẢN TRỊ — Laravel
# ==========================================================================
server {
    listen 443 ssl;
    http2 on;
    server_name ${PSV_API_DOMAIN};
    access_log /var/log/nginx/access.log psv_co_ten_mien;

    ssl_certificate     /etc/letsencrypt/live/${PSV_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PSV_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # Trang Chấm công (/admin/cham-cong) cần camera (chụp khuôn mặt) và vị trí
    # (GPS) — chỉ cho chính trang này, không cho trang / khung nhúng nơi khác.
    add_header Permissions-Policy "geolocation=(self), microphone=(), camera=(self), payment=(), usb=()" always;

    root /var/www/public;
    index index.php;
    client_max_body_size 20M;

    gzip on;
    # application/wasm: bộ nhận diện khuôn mặt (trang Chấm công) nén còn ~1/2
    gzip_types application/json application/javascript text/css application/wasm;
    gzip_min_length 1024;

    # Ảnh admin tải lên. Trỏ thẳng thư mục thật thay vì qua liên kết tượng
    # trưng public/storage — không phụ thuộc `artisan storage:link`.
    location /storage/ {
        alias /var/www/storage/app/public/;
        access_log off;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";

        # Khối này có add_header riêng nên KHÔNG kế thừa header bảo mật của
        # server (luật của nginx) — trước đây tệp upload mất sạch HSTS, nosniff…
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()" always;
        # Tệp người dùng tải lên KHÔNG BAO GIỜ được chạy mã. Thư mục này nằm
        # cùng tên miền với trang /admin: một ảnh SVG chứa JavaScript mở trực
        # tiếp sẽ chạy với quyền của admin đang đăng nhập. "sandbox" + cấm
        # script vô hiệu hoá điều đó; ảnh nhúng qua <img> vẫn hiển thị bình thường.
        add_header Content-Security-Policy "default-src 'none'; img-src 'self' data:; style-src 'unsafe-inline'; sandbox" always;

        # Không bao giờ chạy mã trong thư mục người dùng tải lên
        location ~ \.(php|phtml|phar|sh|py|cgi)$ {
            deny all;
        }
        try_files $uri =404;
    }

    # Tệp tĩnh của trang quản trị: giao diện Filament, phông chữ, bộ nhận diện
    # khuôn mặt (~9 MB), bộ đọc QR. Không giới hạn tần suất, trình duyệt giữ 7
    # ngày — trước đây không có hạn giữ nên mỗi lần mở trang lại hỏi máy chủ.
    # JS / CSS của Filament và js/psv có ?v=… đổi theo phiên bản nên sửa xong
    # khách nhận ngay; logo (images/) giữ 1 ngày cho dễ thay.
    # "expires" không phải add_header nên header bảo mật của server vẫn kế thừa.
    location ~ ^/(?:js|css|fonts|vendor)/ {
        expires 7d;
        access_log off;
        # Khối này đứng trước khối chặn tệp ẩn / .php cuối file nên tự chặn lại
        location ~ (?:\.(?:php|phtml|phar)$|/\.) {
            deny all;
        }
        try_files $uri =404;
    }
    location ^~ /images/ {
        expires 1d;
        access_log off;
        location ~ (?:\.(?:php|phtml|phar)$|/\.) {
            deny all;
        }
        try_files $uri =404;
    }

    # Trang đăng nhập quản trị — siết chặt để chặn dò mật khẩu tự động
    location = /admin/login {
        limit_req zone=psv_dangnhap burst=5 nodelay;
        try_files $uri /index.php?$query_string;
    }

    # Trang quản trị + API (xem giới hạn ở đầu file). Một lượt chỉ tính một lần
    # dù đi tiếp sang khối .php bên dưới.
    location / {
        limit_req zone=psv_chung burst=150 delay=60;
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        limit_req zone=psv_chung burst=150 delay=60;
        try_files $uri =404;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass app:9000;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        # Laravel đứng sau nginx nên phải tự báo là đang chạy HTTPS,
        # thiếu dòng này thì mọi đường dẫn sinh ra sẽ là http://
        fastcgi_param HTTPS on;
        fastcgi_read_timeout 300;
        fastcgi_buffers 16 32k;
        fastcgi_buffer_size 64k;
    }

    # Chặn truy cập .env, .git và mọi tệp ẩn
    location ~ /\.(?!well-known).* {
        deny all;
    }
}
