# ============================================================
#  PSV Travel — cấu hình MÁY CHỦ THẬT
#
#  Trên VPS:  cp .env.production.example .env  rồi điền các chỗ ĐIỀN_VÀO_ĐÂY
#  KHÔNG BAO GIỜ commit file .env lên git.
# ============================================================

# ---- Tên miền ----------------------------------------------
# Hai dòng này docker-compose.prod.yml và nginx đều đọc.
# Đổi thành tên miền thật của công ty, KHÔNG có https:// và không có / ở cuối.
PSV_DOMAIN=psvtravel.vn
PSV_API_DOMAIN=api.psvtravel.vn

APP_NAME="PSV Travel"
APP_ENV=production
# Sinh bằng: docker compose -f docker-compose.prod.yml run --rm app php artisan key:generate --show
APP_KEY=ĐIỀN_VÀO_ĐÂY
# BẮT BUỘC false. Để true là lộ đường dẫn máy chủ, tên bảng và cấu hình
# cho bất kỳ ai gặp trang lỗi.
APP_DEBUG=false
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_URL=https://api.psvtravel.vn

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
# Giữ log 14 ngày rồi tự xoá, tránh đầy ổ đĩa
LOG_DAILY_DAYS=14

# ---- Cơ sở dữ liệu -----------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=psvtravel
DB_USERNAME=psvtravel
# Đặt mật khẩu dài, ngẫu nhiên. Tạo bằng:  openssl rand -base64 32
DB_PASSWORD=ĐIỀN_VÀO_ĐÂY

# ---- Session / Cache / Queue -------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Để phiên đăng nhập quản trị chỉ gửi kèm đúng tên miền api
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# ---- Redis -------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
# Tạo bằng:  openssl rand -base64 32
REDIS_PASSWORD=ĐIỀN_VÀO_ĐÂY
REDIS_PORT=6379

# ---- Gửi mail (Brevo) --------------------------------------
# Vào Brevo -> SMTP & API -> tạo khoá MỚI. Khoá cũ đã lộ trong lịch sử git,
# phải xoá đi.
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_SCHEME=tls
MAIL_USERNAME=ĐIỀN_VÀO_ĐÂY
MAIL_PASSWORD=ĐIỀN_VÀO_ĐÂY
MAIL_FROM_ADDRESS="no-reply@psvtravel.vn"
MAIL_FROM_NAME="${APP_NAME}"

LUOT_XEM_CACH_NHAU_PHUT=60

# ---- Địa chỉ website (dùng cho CORS và link trong mail) -----
FRONTEND_URL=https://psvtravel.vn
