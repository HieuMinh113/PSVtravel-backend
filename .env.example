# ============================================================
#  PSV Travel — Backend
#  Copy file này thành .env rồi chỉnh, KHÔNG commit file .env
#  Các giá trị dưới đây khớp sẵn với docker-compose.yml
# ============================================================

APP_NAME="PSV Travel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_URL=http://localhost:8000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- Cơ sở dữ liệu -----------------------------------------
# Chạy bằng Docker: giữ nguyên host là "postgres" (tên service).
# Chạy artisan từ Windows (ngoài Docker): đổi thành 127.0.0.1
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=psvtravel
DB_USERNAME=psvtravel
DB_PASSWORD=secret

# ---- Session / Cache / Queue -------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# ---- Redis -------------------------------------------------
# Chỉ dùng được khi chạy trong Docker (PHP trên Windows thường
# không có extension redis). Ngoài Docker cứ để CACHE_STORE=database.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---- Gửi mail (OTP đăng ký) --------------------------------
# Mặc định ghi ra file log để dev không cần cấu hình gì:
#   xem mã OTP tại storage/logs/laravel.log
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@psvtravel.com"
MAIL_FROM_NAME="${APP_NAME}"

# Bật mail thật (Brevo) thì đổi MAIL_MAILER=smtp và điền 4 dòng dưới.
# MAIL_MAILER=smtp
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_SCHEME=tls
# MAIL_USERNAME=
# MAIL_PASSWORD=

# ---- Kiểm thử -----------------------------------------------
# Một máy đọc lại bài cẩm nang trong bao nhiêu phút thì chỉ tính 1 lượt xem.
# Đặt 0 để tắt hẳn khi cần đếm từng lần bấm lúc kiểm thử.
LUOT_XEM_CACH_NHAU_PHUT=60

# ---- Địa chỉ website (dùng cho CORS và link trong mail) -----
FRONTEND_URL=http://localhost:3000
